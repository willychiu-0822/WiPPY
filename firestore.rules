rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profile doc (created on first login) ─────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Frontend only creates this doc on first login (displayName, email, timezone, createdAt).
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'timezone', 'createdAt'])
        && request.resource.data.timezone is string
        && request.resource.data.timezone.size() <= 64
        && (!('displayName' in request.resource.data) || request.resource.data.displayName == null || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200))
        && (!('email' in request.resource.data) || request.resource.data.email == null || (request.resource.data.email is string && request.resource.data.email.size() <= 320));
      allow delete: if false;
    }

    // ── V2: Groups ────────────────────────────────────────────────────────────
    // Backend (service account) writes via Admin SDK — bypasses these rules.
    // Frontend reads are auth-protected by userId field match.
    match /groups/{groupId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Backend only

      match /recentMessages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/groups/$(groupId)).data.userId == request.auth.uid;
        allow write: if false; // Backend only
      }
    }

    // ── V2: Activities ────────────────────────────────────────────────────────
    match /activities/{activityId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Activity lifecycle and ownership are backend-only.

      match /activityMessages/{msgId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/activities/$(activityId)).data.userId == request.auth.uid;
        allow write: if false; // Prevent forged owners, review status and scheduler payloads.
      }
      match /captureRules/{ruleId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/activities/$(activityId)).data.userId == request.auth.uid;
        allow write: if false; // Prevent forged owners, review status and scheduler payloads.
      }
    }

    // ── V2: Activity Knowledge ────────────────────────────────────────────────
    match /activityKnowledge/{knowledgeId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Frontend uses the backend API; only Admin SDK may write.
    }

    // ── V2: Agent Sessions ────────────────────────────────────────────────────
    match /agentSessions/{sessionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Frontend only reads via getDoc; writes go through the backend API.
    }

    // ── V2: Captured messages ─────────────────────────────────────────────────
    match /capturedMessages/{msgId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Backend only
    }

    // ── V2: Send logs ─────────────────────────────────────────────────────────
    match /sendLogs/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Backend only
    }

    // ── Harness: HarnessRun (frontend subscribes via onSnapshot) ─────────────
    match /harnessRuns/{runId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Backend only
    }

    // ── Harness: Rate limits (backend only) ───────────────────────────────────
    match /rateLimits/{userId} {
      allow read, write: if false; // Backend only
    }

    // ── Agent Hub: backend only (agents and the owner use /api/hub) ─────────
    match /systemState/{id} { allow read, write: if false; }
    match /groupMessages/{id} { allow read, write: if false; }
    match /mediaAssets/{id} { allow read, write: if false; }
    match /agents/{id} { allow read, write: if false; }
    match /agentRules/{id} { allow read, write: if false; }
    match /hubRuleState/{id} { allow read, write: if false; }
    match /agentDispatches/{id} { allow read, write: if false; }
    match /agentInbox/{id} { allow read, write: if false; }
    match /digests/{id} { allow read, write: if false; }
    match /hubActions/{id} { allow read, write: if false; }
    match /agentRecords/{id} { allow read, write: if false; }
    match /hubSettings/{id} { allow read, write: if false; }
    match /hubCounters/{id} { allow read, write: if false; }
    match /hubQuota/{id} { allow read, write: if false; }
    match /hubAlerts/{id} { allow read, write: if false; }
    match /hubAuditLogs/{id} { allow read, write: if false; }
    match /hubAccounts/{id} { allow read, write: if false; }
    match /hubGroupStats/{id} { allow read, write: if false; }
  }
}
