# Non-secret production deployment target for WiPPY.
# GitHub Actions reads this file before deploying.

GCP_PROJECT_ID=wippy-mvp
GCP_PROJECT_NUMBER=427895539129
GCP_REGION=asia-east1

CLOUD_RUN_SERVICE=wippy-backend
CLOUD_RUN_URL=https://wippy-backend-ts2nxgrpfa-de.a.run.app

FIREBASE_PROJECT_ID=wippy-mvp
FIREBASE_HOSTING_URL=https://wippy-mvp.web.app
FIREBASE_HOSTING_PUBLIC=frontend/dist
FIRESTORE_RULES=firestore.rules
FIRESTORE_INDEXES=firestore.indexes.json

VITE_FIREBASE_PROJECT_ID=wippy-mvp
VITE_FIREBASE_AUTH_DOMAIN=wippy-mvp.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=wippy-mvp.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=427895539129
VITE_FIREBASE_APP_ID=1:427895539129:web:cac964fbda3640f8c4e268
LIFF_CHANNEL_ID=2010457997
LIFF_ID=2010457997-AsUbpde2
VITE_LIFF_ID=2010457997-AsUbpde2

# Backend runtime settings that are not secrets (passed to Cloud Run by deploy.yml).
# Secrets (GEMINI_API_KEY, HUB_ENCRYPTION_KEY, SCHEDULER_SECRET, LINE_*, OWNER_USER_ID,
# INTERNAL_HARNESS_SECRET) must NOT be written here; see docs/AUDIT-FIX-20261116.md.
# (NODE_ENV is set directly in deploy.yml: this file is exported to GITHUB_ENV, and
# NODE_ENV=production there would make the frontend `npm ci` skip devDependencies.)
LLM_PROVIDER=gemini
LLM_MODEL=gemma-4-26b-a4b-it

# Empty means frontend calls /api on Firebase Hosting, then firebase.json rewrites to Cloud Run.
VITE_API_BASE_URL=

# Agent Hub (see docs/agent-hub-setup-guide.md). Secrets HUB_ENCRYPTION_KEY and
# SCHEDULER_SECRET live in GitHub Actions secrets, not here.
HUB_PUBLIC_BASE_URL=https://wippy-mvp.web.app
HUB_MEDIA_BUCKET=wippy-mvp-hub-media
HUB_TASKS_QUEUE=wippy-hub-jobs
HUB_TASKS_LOCATION=asia-east1

# Browser origins allowed to call the backend. Localhost is intentionally omitted.
CORS_ORIGINS=https://wippy-mvp.web.app,https://wippy-mvp.firebaseapp.com
