{
  "name": "wippy-backend",
  "version": "1.0.0",
  "description": "WiPPY Cloud Run backend - LINE Bot webhook and scheduler",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "dev:watch": "nodemon --exec ts-node src/index.ts --ext ts",
    "build": "tsc",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "dump:run": "ts-node src/scripts/dumpRun.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  },
  "dependencies": {
    "@google-cloud/tasks": "^6.3.0",
    "@google/genai": "^1.50.1",
    "@line/bot-sdk": "^9.4.0",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "dotenv": "^17.4.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "google-auth-library": "^10.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
